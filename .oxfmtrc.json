{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "plugins/automations/server/engine/generated/**",
    "plugins/automations/server/engine/upstream/**",
    "plugins/automations/server/engine/provenance.json",
    "plugins/automations/server/engine/dist/**",
    "*.lock",
    "**/*.gen.ts",
    "**/*.gen.tsx",
    "plugins/source-control/client/generated/editor-html.ts"
  ]
}
