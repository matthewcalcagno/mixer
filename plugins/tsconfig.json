{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": { "@roboplane/*": ["./automations/server/engine/upstream/packages/*/src/index.ts"] },
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vitest/globals"],
    "incremental": false,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "**/*.test.ts", "automations/server/engine", "vitest.config.ts"]
}
