    "micromark-util-decode-string": "2.0.1",
    "mnemonic-id": "^3.2.7",
    "monaco-editor": "0.55.1",
    "monaco-vim": "0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-freeze": "1.0.4",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "4.0.3",
    "react-native-enriched-markdown": "1.2.0-nightly-20261014-766fc0e67",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-unistyles": "3.2.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.4",
    "shiki": "4.5.0",
    "tiny-invariant": "^1.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "use-sync-external-store": "^1.6.0",
    "vscode-json-languageservice": "5.6.4",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-protocol": "3.17.5",
    "vscode-languageserver-textdocument": "1.0.12",
    "yaml": "^2.8.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "~22.19.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@xterm/headless": "^6.1.0-beta.213",
    "babel-preset-expo": "~57.0.16",
    "dotenv": "^17.2.3",
    "esbuild": "0.28.1",
    "eslint": "^10.14.0",
    "eslint-config-expo": "~57.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "material-icon-theme": "^5.32.0",
    "playwright": "^1.56.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.105.0",
    "ws": "^8.20.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  }
}
