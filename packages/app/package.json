    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.28",
    "fast-deep-equal": "^3.1.3",
    "htmlparser2": "^12.0.0",
    "i18next": "^26.3.0",
    "lucide-react-native": "^1.50.0",
    "markdown-it": "^14.3.3",
